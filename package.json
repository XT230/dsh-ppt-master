{
  "name": "@xt230/dsh-ppt-master",
  "version": "1.2.1",
  "description": "Declares a PPT Master agent preset (skill + interpreter tool, scoped to that preset) and manages the Python interpreter and projects root it runs with through the plugin's own Config",
  "type": "module",
  "license": "MIT",
  "author": "xt230",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XT230/dsh-ppt-master.git"
  },
  "homepage": "https://github.com/XT230/dsh-ppt-master#readme",
  "bugs": {
    "url": "https://github.com/XT230/dsh-ppt-master/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./preset": {
      "default": "./lib/preset.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ppt-master",
    "pptx",
    "powerpoint",
    "skill",
    "python"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
